{
  "name": "bhavana",
  "version": "1.0.0",
  "private": true,
  "description": "Bhāvanā — หนังสือสวดมนต์ ห้องสมาธิ และธรรมะ",
  "scripts": {
    "fonts": "node scripts/copy-fonts.mjs",
    "assets": "npx @capacitor/assets generate --iconBackgroundColor '#14275A' --iconBackgroundColorDark '#070F24' --splashBackgroundColor '#14275A' --splashBackgroundColorDark '#070F24'",
    "sync": "npm run fonts && npx cap sync",
    "android": "npm run sync && npx cap open android",
    "ios": "npm run sync && npx cap open ios"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@fontsource/anuphan": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/mitr": "^5.3.0",
    "@fontsource/noto-serif-thai": "^5.3.0"
  }
}
